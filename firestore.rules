rules_version = '2';

// Everything lives inside a league, and only league members can read or write its data.
// The posture is deliberately light: members are trusted, so these rules prevent mistakes
// (wrong shapes, impersonation, rewriting history) rather than abuse.
//
// Fields marked "functions only" are written with the Admin SDK, which bypasses these rules:
//   leagues:  everything after creation (joinLeague, removeMember, regenerateInvite)
//   players:  linkedUid, mergedInto (mergePlayers, unmergePlayers, joinLeague)
//   games:    status, summary, summaryError (onRoundWrite)
//   log:      all writes
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(leagueId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/leagues/$(leagueId)).data.memberUids;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function nonEmptyString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    match /leagues/{leagueId} {
      // Lets a user list their leagues with where('memberUids', 'array-contains', uid).
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      // Anyone signed in can start a league and becomes its only member and admin.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'adminUid', 'inviteCode', 'memberUids', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'adminUid', 'inviteCode', 'memberUids', 'createdAt'])
        && nonEmptyString(request.resource.data.name, 60)
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && nonEmptyString(request.resource.data.inviteCode, 32)
        && request.resource.data.createdAt is number;

      allow update, delete: if false;

      match /players/{playerId} {
        allow read: if isMember(leagueId);

        // Guests only: linking to a login or merging goes through functions.
        allow create: if isMember(leagueId)
          && request.resource.data.keys().hasOnly(['name', 'linkedUid', 'retired', 'mergedInto', 'createdBy', 'createdAt'])
          && request.resource.data.keys().hasAll(['name', 'linkedUid', 'retired', 'mergedInto', 'createdBy', 'createdAt'])
          && nonEmptyString(request.resource.data.name, 40)
          && request.resource.data.linkedUid == null
          && request.resource.data.mergedInto == null
          && request.resource.data.retired == false
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is number;

        // Rename or retire only.
        allow update: if isMember(leagueId)
          && changedKeys().hasOnly(['name', 'retired'])
          && nonEmptyString(request.resource.data.name, 40)
          && request.resource.data.retired is bool;

        allow delete: if false;
      }

      match /games/{gameId} {
        allow read: if isMember(leagueId);

        allow create: if isMember(leagueId)
          && request.resource.data.keys().hasOnly(['settings', 'seatOrder', 'status', 'createdBy', 'createdAt', 'split', 'summary', 'summaryError'])
          && request.resource.data.keys().hasAll(['settings', 'seatOrder', 'status', 'createdBy', 'createdAt', 'split', 'summary', 'summaryError'])
          && request.resource.data.settings is map
          && request.resource.data.settings.limit is int
          && request.resource.data.settings.buyIn is int
          && request.resource.data.seatOrder is list
          && request.resource.data.seatOrder.size() >= 2
          && request.resource.data.status == 'inProgress'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is number
          && request.resource.data.split == null
          && request.resource.data.summary == null
          && request.resource.data.summaryError == null;

        // Settings and seating are locked once created. The only client change is the split.
        allow update: if isMember(leagueId)
          && changedKeys().hasOnly(['split'])
          && (request.resource.data.split == null || request.resource.data.split is map);

        allow delete: if false;

        match /rounds/{roundId} {
          allow read: if isMember(leagueId);

          allow create: if isMember(leagueId)
            && request.resource.data.keys().hasOnly(['seq', 'winnerId', 'entries', 'rejoins', 'scrapped', 'updatedBy', 'updatedAt', 'history'])
            && request.resource.data.keys().hasAll(['seq', 'winnerId', 'entries', 'rejoins', 'scrapped', 'updatedBy', 'updatedAt', 'history'])
            && request.resource.data.seq is int
            && request.resource.data.seq > 0
            && request.resource.data.winnerId is string
            && request.resource.data.entries is map
            && request.resource.data.rejoins is list
            && request.resource.data.scrapped == null
            && request.resource.data.history == []
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt is number;

          // Every change (edit, scrap, restore) appends exactly one history entry made by the
          // caller and keeps all earlier entries untouched, so prior values are never lost.
          allow update: if isMember(leagueId)
            && request.resource.data.keys().hasOnly(['seq', 'winnerId', 'entries', 'rejoins', 'scrapped', 'updatedBy', 'updatedAt', 'history'])
            && request.resource.data.seq == resource.data.seq
            && request.resource.data.winnerId is string
            && request.resource.data.entries is map
            && request.resource.data.rejoins is list
            && (request.resource.data.scrapped == null
                || (request.resource.data.scrapped is map
                    && nonEmptyString(request.resource.data.scrapped.reason, 200)))
            && (request.resource.data.scrapped == resource.data.scrapped
                || request.resource.data.scrapped == null
                || request.resource.data.scrapped.by == request.auth.uid)
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt is number
            && request.resource.data.history is list
            && request.resource.data.history.size() == resource.data.history.size() + 1
            && (resource.data.history.size() == 0
                || request.resource.data.history[0:resource.data.history.size()] == resource.data.history)
            && request.resource.data.history[resource.data.history.size()].by == request.auth.uid
            && request.resource.data.history[resource.data.history.size()].prev is map;

          allow delete: if false;
        }
      }

      match /log/{entryId} {
        allow read: if isMember(leagueId);
        allow write: if false;
      }
    }
  }
}

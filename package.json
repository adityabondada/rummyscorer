{
  "name": "rummytracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "engine",
    "data",
    "web",
    "functions"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:rules": "npm run test:rules --workspace data",
    "test:functions": "npm run test:emulator --workspace functions",
    "test:e2e": "npm run test:e2e --workspace functions",
    "test:emulator": "npm run test:rules && npm run test:functions",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "dev": "npm run dev --workspace web",
    "emulators": "firebase emulators:start --project demo-rummytracker"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}

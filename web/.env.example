# Copy to .env.local to run against the real Firebase project instead of the local emulators.
# These values come from the Firebase console (Project settings > Your apps > Web app). They are
# not secrets, but keep them out of git anyway; .env.local is ignored.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=rummytracker-8eab5.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rummytracker-8eab5
VITE_FIREBASE_APP_ID=

# Optional. In dev the app uses the emulators unless an API key is set above; force it either way:
# VITE_USE_EMULATORS=true
# Must match the region the functions are deployed to.
# VITE_FUNCTIONS_REGION=us-central1
